{
  "name": "personal-finance-tracker",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.1 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write src package.json tsconfig.json next.config.ts eslint.config.mjs README.md",
    "format:check": "prettier --check src package.json tsconfig.json next.config.ts eslint.config.mjs README.md",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "test": "node --experimental-strip-types --test src/lib/finance/*.test.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "bootstrap": "5.3.8",
    "chart.js": "4.5.1",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "^10",
    "prettier": "^3",
    "typescript": "^5"
  },
  "prettier": {
    "singleQuote": true
  }
}
